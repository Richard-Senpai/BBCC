# Environment Variables — BBCCILEIFE 40-Day Challenge
#
# Copy this file to .env.local and fill in your Supabase project values.
# Never commit .env.local to git.

# ── Supabase (required) ─────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key — only used in server-side scripts (e.g. seed scripts)
# NEVER expose this in the browser or commit it to source control.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
